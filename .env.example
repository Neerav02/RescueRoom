# ==============================================================================
# RESCUEROOM ENVIRONMENT CONFIGURATION (STAGING & PRODUCTION)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE ENVIRONMENT VARIABLES (PUBLIC)
# These variables are compiled into the browser bundle and identify the application.
# They MUST NOT contain secret keys or privileged credentials.
# ------------------------------------------------------------------------------
VITE_COMETCHAT_APP_ID=your_cometchat_app_id
VITE_COMETCHAT_REGION=us

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ENVIRONMENT VARIABLES (CONFIDENTIAL — NEVER PREFIX WITH VITE_)
# Maintained strictly on the backend server or container environment.
# These credentials are NEVER sent to or visible in client browsers.
# ------------------------------------------------------------------------------

# Server listen port (default: 3001)
PORT=3001

# CometChat REST API Key (Privileged credential for minting user auth tokens)
# Obtained from CometChat Dashboard -> API & Auth Keys -> REST API Keys
COMETCHAT_API_KEY=your_cometchat_rest_api_key

# CometChat App ID & Region for backend (can mirror client values)
COMETCHAT_APP_ID=your_cometchat_app_id
COMETCHAT_REGION=us

# Google Gemini API Key (Used strictly on server for multimodal failure analysis)
# Obtained from Google AI Studio (https://aistudio.google.com/)
# Optional: If omitted, server automatically engages Tactical Machinery Forensics Engine
GEMINI_API_KEY=your_google_gemini_api_key_optional
